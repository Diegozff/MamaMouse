# ──────────────────────────────────────────────────────────
# Mama Mouse – Variables de entorno
# Copiá este archivo como ".env" y completá tus credenciales
# ──────────────────────────────────────────────────────────

# Contraseña del panel (?admin). Se valida en el SERVIDOR (ya no va en el navegador).
# Si no se define, el servidor usa VITE_ADMIN_PASS (la variable vieja) para no romper nada.
ADMIN_PASS=cambiame

# Poné ADMIN_ENFORCE=1 cuando el panel ya se haya recargado con la versión nueva:
# a partir de ahí los endpoints de admin exigen sesión. Sin esto el servidor avisa en el log.
# ADMIN_ENFORCE=1

# Token para /api/run-reminders (cron externo). Si no se define usa uno por defecto: definilo.
# CRON_SECRET=un-valor-largo-y-aleatorio

# Email (Brevo API): clave de https://app.brevo.com
# BREVO_API_KEY=xkeysib-...
# ANTHROPIC_API_KEY=sk-ant-...

# URL pública de la app (para links en emails/WhatsApp)
APP_URL=http://localhost:5173

# ── Email (SMTP) ───────────────────────────────────────────
# Opción 1: Gmail con App Password
#   1. Activá verificación en 2 pasos en tu cuenta Google
#   2. Entrá a: myaccount.google.com/apppasswords
#   3. Generá una App Password para "Mail"
#   4. Pegala en SMTP_PASS (sin espacios)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tumismo@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
EMAIL_FROM=Mama Mouse <tumismo@gmail.com>

# Opción 2: Otro proveedor SMTP (Hostinger, GoDaddy, etc.)
# SMTP_HOST=mail.tudominio.com
# SMTP_PORT=587
# SMTP_USER=reservas@tudominio.com
# SMTP_PASS=tupassword

# ── WhatsApp (Twilio) ──────────────────────────────────────
# 1. Creá cuenta en https://www.twilio.com (es gratis para sandbox)
# 2. Activá el sandbox de WhatsApp: console.twilio.com/us1/develop/sms/try-it-out/whatsapp-learn
# 3. Pedí a cada viajero que envíe "join <tu-sandbox-code>" a +14155238886
# 4. En producción: solicitá un número propio en Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
